# ============================================================
# Burs Otomasyonu — Ortam Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   copy .env.example .env
# ============================================================

# --- Gemini AI ---
# Google AI Studio'dan alın: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- YouTube Data API v3 ---
# Google Cloud Console > Kimlik Bilgileri > OAuth 2.0 İstemci Kimlikleri
# Uygulama türü: Masaüstü Uygulaması → JSON olarak indirin
YOUTUBE_CLIENT_SECRETS_PATH=client_secrets.json

# --- YouTube Token (otomatik oluşturulur) ---
YOUTUBE_TOKEN_PATH=token.json

# --- İsteğe Bağlı ---
# Telegram Bot (Faz 2 için)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
